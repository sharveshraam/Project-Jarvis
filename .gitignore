.gradle/
build/
local.properties
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/
release/

# Kotlin
*.class

# Signing material must NEVER be committed
*.jks
*.keystore
keystore.properties
