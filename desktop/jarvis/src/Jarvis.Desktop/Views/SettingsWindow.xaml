<Window x:Class="Jarvis.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS Settings" Width="900" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="#12161C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,14,10,10">
                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="12,0,0,12" />
                <RadioButton x:Name="NavGeneral" Style="{StaticResource NavRadio}" Content="General" IsChecked="True" />
                <RadioButton x:Name="NavGemini" Style="{StaticResource NavRadio}" Content="Gemini" />
                <RadioButton x:Name="NavVoice" Style="{StaticResource NavRadio}" Content="Voice" />
                <RadioButton x:Name="NavModes" Style="{StaticResource NavRadio}" Content="Modes" />
                <RadioButton x:Name="NavPermissions" Style="{StaticResource NavRadio}" Content="Permissions" />
                <RadioButton x:Name="NavFiles" Style="{StaticResource NavRadio}" Content="Files &amp; search" />
                <RadioButton x:Name="NavAutomation" Style="{StaticResource NavRadio}" Content="Automation" />
                <RadioButton x:Name="NavMemory" Style="{StaticResource NavRadio}" Content="Memory" />
                <RadioButton x:Name="NavTasks" Style="{StaticResource NavRadio}" Content="Background tasks" />
                <RadioButton x:Name="NavActivity" Style="{StaticResource NavRadio}" Content="Activity &amp; data" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">

            <!-- General -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavGeneral, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="What should JARVIS call you?" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding UserName, Mode=TwoWay}" MaxWidth="320" HorizontalAlignment="Left" MinWidth="320" />

                    <TextBlock Text="Startup and window" Style="{StaticResource HeadingText}" />
                    <CheckBox Style="{StaticResource DarkCheckBox}" Content="Start JARVIS in the system tray when I sign in to Windows"
                              IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
                    <CheckBox Style="{StaticResource DarkCheckBox}" Content="Keep the assistant panel above other windows"
                              IsChecked="{Binding KeepOnTop, Mode=TwoWay}" />

                    <TextBlock Text="Global shortcuts" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="Show or hide the assistant" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding ToggleHotkey, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" />
                    <TextBlock Text="Push to talk (hold while speaking)" Style="{StaticResource MutedText}" Margin="0,10,0,3" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding PushToTalkHotkey, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Write shortcuts as modifier keys plus one key, for example Ctrl+Alt+J or Ctrl+Shift+Space. The microphone is only open while push to talk is held; there is no wake word and nothing listens in the background." />

                    <TextBlock Text="Data location" Style="{StaticResource HeadingText}" />
                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding DataFolder, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource FlatButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="Open logs" Command="{Binding OpenLogFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Gemini -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavGemini, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Gemini" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Gemini provides conversation, planning, screen understanding and web research. Your key is encrypted with Windows DPAPI for your user account and is never written to logs, memory or the database. Without a key JARVIS still runs local commands (reminders, tasks, apps, system, files)." />
                    <TextBlock Text="{Binding ApiKeyStatus}" Style="{StaticResource BodyText}" Margin="0,10,0,6" />
                    <TextBlock Text="API key" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                    <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource SecretBox}" Width="420" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Save key" Command="{Binding SaveApiKeyCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="Test connection" Command="{Binding TestGeminiCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Remove key" Command="{Binding RemoveApiKeyCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding GeminiTestResult}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />

                    <TextBlock Text="Model" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="Model name" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding GeminiModel, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" />
                    <TextBlock Text="API version" Style="{StaticResource MutedText}" Margin="0,10,0,3" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding GeminiApiVersion, Mode=TwoWay}" Width="160" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Change these only if Google renames or retires the model. Save, then use “Test connection”." />
                </StackPanel>
            </ScrollViewer>

            <!-- Voice -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavVoice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Voice" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Speech recognition and speech output both use the engines built into Windows, so audio stays on this PC." />
                    <CheckBox Style="{StaticResource DarkCheckBox}" Content="Speak replies when I ask by voice" Margin="0,10,0,4"
                              IsChecked="{Binding SpeakResponses, Mode=TwoWay}" />
                    <CheckBox Style="{StaticResource DarkCheckBox}" Content="Also speak replies when I type"
                              IsChecked="{Binding SpeakTypedReplies, Mode=TwoWay}" />
                    <TextBlock Text="Voice" Style="{StaticResource MutedText}" Margin="0,12,0,3" />
                    <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Voices}" SelectedItem="{Binding VoiceName, Mode=TwoWay}"
                              Width="320" HorizontalAlignment="Left" />
                    <TextBlock Text="Speaking rate (slower ← → faster)" Style="{StaticResource MutedText}" Margin="0,12,0,3" />
                    <Slider Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Width="320" HorizontalAlignment="Left"
                            Value="{Binding SpeechRate, Mode=TwoWay}" />
                    <Button Style="{StaticResource FlatButton}" Content="Test voice" Command="{Binding TestVoiceCommand}" HorizontalAlignment="Left"
                            Margin="0,12,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" Text="Save first so the test uses the voice and rate chosen here." />
                </StackPanel>
            </ScrollViewer>

            <!-- Modes -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavModes, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Modes" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Each mode changes how JARVIS behaves and which tools it may use. Here you choose the workspace a mode opens: apps, folders and files." />
                    <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding ModeList}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" Margin="0,10,0,4" />
                    <TextBlock Text="{Binding SelectedModePurpose}" Style="{StaticResource BodyText}" Margin="0,0,0,8" />

                    <TextBlock Text="Apps to launch (one per line — a name such as “chrome”, or a full path)" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding ModeApps, Mode=TwoWay}" />
                    <TextBlock Text="Folders to open (one per line)" Style="{StaticResource MutedText}" Margin="0,10,0,3" />
                    <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding ModeFolders, Mode=TwoWay}" />
                    <TextBlock Text="Files to open (one per line)" Style="{StaticResource MutedText}" Margin="0,10,0,3" />
                    <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding ModeFiles, Mode=TwoWay}" />
                    <TextBlock Text="Project folder (Development mode: opened in VS Code and used by the Git and project tools)"
                               Style="{StaticResource MutedText}" Margin="0,10,0,3" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding ModeProjectPath, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Permissions -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavPermissions, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Permissions" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Read-only actions run directly. Routine, reversible actions (opening an app, adding a reminder) run directly when trusted. Consequential actions — bulk file moves, overwriting, running commands, sending your screen or clipboard to Gemini without being asked — always need your approval and cannot be set to run silently." />
                    <CheckBox Style="{StaticResource DarkCheckBox}" Content="Trust routine actions (run them without asking)" Margin="0,10,0,10"
                              IsChecked="{Binding TrustRoutineActions, Mode=TwoWay}" />
                    <ItemsControl ItemsSource="{Binding Permissions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontFamily="Consolas" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RiskText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="2" Style="{StaticResource DarkCombo}" ItemsSource="{Binding Levels}"
                                                  SelectedItem="{Binding Level, Mode=TwoWay}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Files and search -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavFiles, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Files &amp; search" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="Folders covered by search (one per line)" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding IndexedFolders, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="File names plus the text of PDF, Word, text, Markdown and source files are indexed into a local database. Nothing is uploaded. Save before rebuilding." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Rebuild index" Command="{Binding RebuildIndexCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource FlatButton}" Content="Clear index" Command="{Binding ClearIndexCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding IndexStatus}" Style="{StaticResource BodyText}" Margin="0,8,0,0" />

                    <TextBlock Text="Extra folders JARVIS may work in" Style="{StaticResource HeadingText}" />
                    <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding AllowedFolders, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="File tools are limited to your user profile plus the folders listed here (one per line). Windows, Program Files and other system locations are always off limits, and JARVIS has no delete tool." />
                </StackPanel>
            </ScrollViewer>

            <!-- Automation -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavAutomation, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Automation" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="App names (one per line: name = path or URI)" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding AppAliases, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="Common apps and anything in your Start menu are found automatically. Add a line here only when a name is not recognised, e.g. “music = C:\Program Files\Player\player.exe”." />

                    <TextBlock Text="Distracting apps (one per line)" Style="{StaticResource MutedText}" Margin="0,14,0,3" />
                    <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding DistractingApps, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="A focus session can ask these apps to close. They are closed gracefully (never force-killed), so unsaved-work prompts still appear, and JARVIS offers to reopen them afterwards." />

                    <TextBlock Text="Approved commands" Style="{StaticResource HeadingText}" />
                    <TextBox Style="{StaticResource MultiLineBox}" Text="{Binding ApprovedCommands, Mode=TwoWay}" MinHeight="90" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="One per line: name | executable | arguments | working folder | trusted (yes/no) | run on dev setup (yes/no). Example: build | dotnet | build | C:\Code\MyApp | no | yes. JARVIS can only run commands listed here, by name, with exactly these arguments — Gemini can never supply a command line. Untrusted commands ask every time." />

                    <TextBlock Text="Daily briefings" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="Morning briefing time (24-hour HH:mm, empty to turn off)" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding MorningBriefingTime, Mode=TwoWay}" Width="120" HorizontalAlignment="Left" />
                    <TextBlock Text="End-of-day summary time (24-hour HH:mm, empty to turn off)" Style="{StaticResource MutedText}" Margin="0,10,0,3" />
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding EndOfDaySummaryTime, Mode=TwoWay}" Width="120" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>

            <!-- Memory -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavMemory, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Memory" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="What JARVIS remembers about you is stored only on this PC. Passwords, API keys and similar secrets are refused. Only the few entries relevant to a request are sent to Gemini with it." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                        <Button Style="{StaticResource FlatButton}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Clear all memory" Click="OnClearMemory" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Memories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Content}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="Forget" VerticalAlignment="Center"
                                                Command="{Binding DataContext.DeleteMemoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Background tasks -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavTasks, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Background tasks" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Multi-step jobs keep running while the panel is hidden. Progress is saved after every step, so a task survives a restart; a step that was interrupted mid-way waits for you instead of being repeated blindly." />
                    <CheckBox Style="{StaticResource DarkCheckBox}" Content="Pause all tasks" Margin="0,10,0,8"
                              IsChecked="{Binding TasksPaused, Mode=TwoWay}" />
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource FlatButton}" Content="Pause" Margin="0,0,6,0"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}" />
                                            <Button Style="{StaticResource FlatButton}" Content="Resume" Margin="0,0,6,0"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}" />
                                            <Button Style="{StaticResource DangerButton}" Content="Cancel"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Id}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Activity and data -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,10,22,10"
                          Visibility="{Binding IsChecked, ElementName=NavActivity, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Your data" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="Conversations, memory, tasks and settings live in a local database in the data folder. JARVIS sends no telemetry." />
                    <Button Style="{StaticResource DangerButton}" Content="Delete all conversations" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="OnDeleteConversations" />

                    <TextBlock Text="Recent actions" Style="{StaticResource HeadingText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,6"
                               Text="Every action JARVIS attempted, whether it was allowed, and whether it happened." />
                    <Button Style="{StaticResource FlatButton}" Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,5">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding When}" Style="{StaticResource MutedText}" Width="110" />
                                            <TextBlock Text="{Binding Tool}" Style="{StaticResource BodyText}" FontFamily="Consolas" FontSize="12" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding Outcome}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" MaxHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" Content="Close" MinWidth="84" Margin="0,0,8,0" Click="OnClose" />
                    <Button Style="{StaticResource AccentButton}" Content="Save" MinWidth="84" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
