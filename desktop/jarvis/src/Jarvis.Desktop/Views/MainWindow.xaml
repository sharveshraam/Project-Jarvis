<Window x:Class="Jarvis.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS" Width="430" Height="640" MinWidth="340" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar (draggable) -->
            <Grid Grid.Row="0" Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="JARVIS" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GeminiReady}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GeminiFailed}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding GeminiText}" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"
                               TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New conversation"
                            Command="{Binding NewConversationCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open this mode's workspace"
                            Command="{Binding OpenWorkspaceCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"
                            Command="{Binding SettingsCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" ToolTip="Hide to tray (Esc)"
                            Command="{Binding HideCommand}" />
                </StackPanel>
            </Grid>

            <!-- Mode selector -->
            <StackPanel Grid.Row="1" Margin="12,2,12,4">
                <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ModePill}" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding Purpose}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding ModePurpose}" Style="{StaticResource MutedText}" />
            </StackPanel>

            <!-- Conversation -->
            <ScrollViewer x:Name="ChatScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="12,4,6,4" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bubble" Margin="0,3,44,3" Padding="10,7" CornerRadius="10" HorizontalAlignment="Left"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="Transparent" BorderThickness="1">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" />
                                    <ItemsControl ItemsSource="{Binding Sources}" Margin="0,4,0,0"
                                                  Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Content="{Binding Title}" ToolTip="{Binding Url}"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Url}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedBrush}" FontSize="10"
                                               HorizontalAlignment="Right" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource UserBubbleBrush}" />
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bubble" Property="Margin" Value="44,3,0,3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNote}" Value="True">
                                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter TargetName="Bubble" Property="Margin" Value="0,3,0,3" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Approval request -->
            <Border Grid.Row="3" Margin="12,4,12,4" Padding="12,10" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    Visibility="{Binding HasApproval, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DataContext="{Binding Approval}">
                    <TextBlock Text="{Binding Origin}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,2,0,4" />
                    <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" FontSize="12" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding RiskText}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                    <CheckBox Style="{StaticResource DarkCheckBox}" Content="Don't ask again for this kind of action"
                              IsChecked="{Binding Remember, Mode=TwoWay}"
                              Visibility="{Binding CanRemember, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource FlatButton}" Content="Deny" MinWidth="80" Margin="0,0,8,0"
                                Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Style="{StaticResource AccentButton}" Content="Approve" MinWidth="80"
                                Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status lines -->
            <StackPanel Grid.Row="4" Margin="14,0,14,2">
                <TextBlock Text="{Binding Activity}" Foreground="{StaticResource AccentBrush}" FontSize="11.5"
                           Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding TaskSummary}" Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasTaskSummary, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Input -->
            <Grid Grid.Row="5" Margin="12,4,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0" Style="{StaticResource InputBox}" AcceptsReturn="True" TextWrapping="Wrap"
                         MaxHeight="110" VerticalScrollBarVisibility="Auto"
                         Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnInputKeyDown" ToolTip="Enter to send · Shift+Enter for a new line" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,0">
                    <Button Content="&#xE720;" ToolTip="{Binding MicToolTip}" Command="{Binding MicCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Stop the current request and any speech"
                            Command="{Binding StopCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE724;" ToolTip="Send (Enter)"
                            Foreground="{StaticResource AccentBrush}" Command="{Binding SendCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
