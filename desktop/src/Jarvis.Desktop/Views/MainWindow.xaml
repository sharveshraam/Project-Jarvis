<Window x:Class="Jarvis.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS" Width="420" Height="620" MinWidth="360" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="CanResizeWithGrip" Loaded="Window_Loaded">
    <Border Background="{StaticResource JarvisBackground}" CornerRadius="14" BorderBrush="#2A3040" BorderThickness="1" Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: identity + status -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="JARVIS" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource JarvisAccent}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource JarvisMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource JarvisMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Mode + task status -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Mode:" Foreground="{StaticResource JarvisMuted}" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" Width="130"/>
                <TextBlock Text="{Binding TaskStatusText}" Foreground="{StaticResource JarvisMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Conversation -->
            <ListBox Grid.Row="2" ItemsSource="{Binding Messages}" Background="{StaticResource JarvisCard}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="{StaticResource JarvisAccent}" FontSize="11"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource JarvisText}"/>
                            <TextBlock Text="{Binding Provenance}" Foreground="{StaticResource JarvisMuted}" FontSize="10"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Mic indicator -->
            <TextBlock Grid.Row="3" Text="{Binding MicIndicatorText}" Foreground="{StaticResource JarvisAccent}" Margin="0,4,0,0"/>

            <!-- Input row -->
            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" Width="260" KeyDown="InputBox_KeyDown"/>
                <Button Content="Send" Command="{Binding SendCommand}"/>
                <Button Content="🎙 Talk" Command="{Binding PushToTalkCommand}"/>
                <Button Content="⏹" Command="{Binding StopSpeechCommand}" ToolTip="Interrupt speech"/>
            </StackPanel>

            <!-- Footer actions -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="New chat" Command="{Binding NewConversationCommand}"/>
                <Button Content="History" Command="{Binding HistoryCommand}"/>
                <Button Content="Settings" Command="{Binding SettingsCommand}"/>
                <Button Content="Hide" Command="{Binding HideCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
