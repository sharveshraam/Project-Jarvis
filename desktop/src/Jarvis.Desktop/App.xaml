<Application x:Class="Jarvis.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="JarvisBackground" Color="#0F1115"/>
            <SolidColorBrush x:Key="JarvisCard" Color="#1A1E27"/>
            <SolidColorBrush x:Key="JarvisAccent" Color="#4CC2FF"/>
            <SolidColorBrush x:Key="JarvisText" Color="#E8ECF1"/>
            <SolidColorBrush x:Key="JarvisMuted" Color="#8A93A6"/>
            <Style TargetType="Button">
                <Setter Property="Background" Value="#232936"/>
                <Setter Property="Foreground" Value="#E8ECF1"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#232936"/>
                <Setter Property="Foreground" Value="#E8ECF1"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="4"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
