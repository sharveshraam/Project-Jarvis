<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Framework Material theme (android:Theme.Material), not AppCompat/Material3.
      The app deliberately has no AndroidX dependency, so every attribute below is a
      platform attribute available since API 21 - and minSdk is 26.
    -->
    <style name="Theme.Jarvis" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/jarvis_primary</item>
        <item name="android:colorPrimaryDark">@color/jarvis_background</item>
        <item name="android:colorAccent">@color/jarvis_secondary</item>
        <item name="android:colorBackground">@color/jarvis_background</item>
        <item name="android:windowBackground">@color/jarvis_background</item>
        <item name="android:textColorPrimary">@color/jarvis_on_background</item>
        <item name="android:textColorSecondary">@color/jarvis_on_surface</item>
        <item name="android:textColorHint">@color/jarvis_outline</item>
        <item name="android:statusBarColor">@color/jarvis_background</item>
        <item name="android:navigationBarColor">@color/jarvis_background</item>
        <item name="android:colorControlNormal">@color/jarvis_primary</item>
        <item name="android:colorControlActivated">@color/jarvis_primary</item>
    </style>

    <style name="Jarvis.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Jarvis.SectionTitle">
        <item name="android:textColor">@color/jarvis_on_background</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Jarvis.Caption">
        <item name="android:textColor">@color/jarvis_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
