        <item name="colorOnPrimary">@color/jarvis_on_primary</item>
        <item name="colorSecondary">@color/jarvis_secondary</item>
        <item name="android:colorBackground">@color/jarvis_background</item>
        <item name="colorOnBackground">@color/jarvis_on_background</item>
        <item name="colorSurface">@color/jarvis_surface</item>
        <item name="colorOnSurface">@color/jarvis_on_surface</item>
        <item name="colorSurfaceVariant">@color/jarvis_surface_variant</item>
        <item name="colorOutline">@color/jarvis_outline</item>
